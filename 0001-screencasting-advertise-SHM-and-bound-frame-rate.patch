+++ b/src/dbus/mutter_screen_cast.rs
@@ -141,6 +141,30 @@ impl ScreenCast {
     async fn version(&self) -> i32 {
         4
     }
+
+    /// Source types niri can capture: monitor and window.
+    ///
+    /// xdg-desktop-portal-gnome reads this to decide which options it shows
+    /// in the screen-cast dialog and to validate the `types` passed to
+    /// SelectSources. Without it the portal reports 0 and rejects every
+    /// request.
+    #[zbus(property)]
+    async fn available_source_types(&self) -> u32 {
+        // 1 = MONITOR, 2 = WINDOW.
+        0b11
+    }
+
+    /// Cursor modes niri supports.
+    ///
+    /// Niri's `CursorMode` numbering differs from Mutter's, so expose the
+    /// Mutter values that map onto what niri actually implements: Hidden (0)
+    /// and Embedded (1). Metadata mode needs pipewire cursor metadata
+    /// support and is downgraded to Embedded at negotiation time anyway.
+    #[zbus(property)]
+    async fn available_cursor_modes(&self) -> u32 {
+        // 1 = HIDDEN, 2 = EMBEDDED (Mutter bit numbering).
+        0b11
+    }
 }
 
