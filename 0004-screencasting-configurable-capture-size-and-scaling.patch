@@ -12,12 +12,20 @@ use crate::utils::MergeWith;
 pub struct Screencasting {
     /// Frame rate advertised to clients, in Hz.
     pub frame_rate_hz: u32,
+    /// Upper bound on the pixel count of a captured frame.
