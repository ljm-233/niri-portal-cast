index 4a4c5467..b8c8439d 100644
--- a/niri-config/src/lib.rs
+++ b/niri-config/src/lib.rs
@@ -2314,7 +2314,6 @@ mod tests {
             },
             screencasting: Screencasting {
                 frame_rate_hz: 60,
