index d7dc35f5..8c60934f 100644
--- a/docs/wiki/Configuration:-Miscellaneous.md
+++ b/docs/wiki/Configuration:-Miscellaneous.md
@@ -26,7 +26,6 @@ cursor {
 
 screencasting {
     frame-rate-hz 60
-    max-shm-buffers 32
 }
 
 overview {
