diff --git a/niri-config/src/screencasting.rs b/niri-config/src/screencasting.rs
index f7e7cc70..dede6232 100644
--- a/niri-config/src/screencasting.rs
+++ b/niri-config/src/screencasting.rs
@@ -2,20 +2,22 @@ use crate::utils::MergeWith;
 
 /// Screencasting limits that keep portal screen sharing usable with clients
 /// that cannot keep up with a full-rate raw stream (Electron/QQ, Feishu, ...).
+///
+/// There is deliberately no shmem buffer pool bound here. PipeWire negotiates
+/// the buffer count for the stream and niri only allocates what it is asked
+/// for (`StreamFlags::ALLOC_BUFFERS`), so an earlier version of this patch
+/// that evicted the oldest buffer past a hard limit was defending against a
+/// mechanism that does not exist. It never triggered in practice.
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 pub struct Screencasting {
     /// Frame rate advertised to clients, in Hz.
     pub frame_rate_hz: u32,
-    /// Hard cap on shmem buffers kept per stream.
-    pub max_shm_buffers: usize,
 }
 
 #[derive(knuffel::Decode, Debug, Default, PartialEq)]
 pub struct ScreencastingPart {
     #[knuffel(child, unwrap(argument))]
     pub frame_rate_hz: Option<u32>,
-    #[knuffel(child, unwrap(argument))]
-    pub max_shm_buffers: Option<usize>,
 }
 
 impl Screencasting {
@@ -23,37 +25,25 @@ impl Screencasting {
     pub const FRAME_RATE_MAX: u32 = 120;
     pub const FRAME_RATE_DEFAULT: u32 = 60;
 
-    /// One buffer is a full raw frame: at the default capture size
-    /// (2560x1600 BGRA) that is 16 MiB, so this bound doubles as the memory
-    /// ceiling for a client that stops consuming.
-    pub const SHM_BUFFERS_MIN: usize = 8;
-    pub const SHM_BUFFERS_MAX: usize = 256;
-    pub const SHM_BUFFERS_DEFAULT: usize = 32;
-
     /// Out-of-range values are clamped rather than rejected, so a typo cannot
     /// leave the compositor advertising a rate that stalls the machine.
     pub fn frame_rate_hz(&self) -> u32 {
         self.frame_rate_hz.clamp(Self::FRAME_RATE_MIN, Self::FRAME_RATE_MAX)
     }
 
-    pub fn max_shm_buffers(&self) -> usize {
-        self.max_shm_buffers
-            .clamp(Self::SHM_BUFFERS_MIN, Self::SHM_BUFFERS_MAX)
-    }
 }
 
 impl Default for Screencasting {
     fn default() -> Self {
         Self {
             frame_rate_hz: Self::FRAME_RATE_DEFAULT,
-            max_shm_buffers: Self::SHM_BUFFERS_DEFAULT,
         }
     }
 }
 
 impl MergeWith<ScreencastingPart> for Screencasting {
     fn merge_with(&mut self, part: &ScreencastingPart) {
-        merge_clone!((self, part), frame_rate_hz, max_shm_buffers);
+        merge_clone!((self, part), frame_rate_hz);
     }
 }
 
@@ -65,33 +55,26 @@ mod tests {
     fn defaults_match_the_documented_values() {
         let s = Screencasting::default();
         assert_eq!(s.frame_rate_hz(), 60);
-        assert_eq!(s.max_shm_buffers(), 32);
     }
 
     #[test]
     fn out_of_range_values_are_clamped() {
         let too_fast = Screencasting {
             frame_rate_hz: 500,
-            max_shm_buffers: 10_000,
         };
         assert_eq!(too_fast.frame_rate_hz(), Screencasting::FRAME_RATE_MAX);
-        assert_eq!(too_fast.max_shm_buffers(), Screencasting::SHM_BUFFERS_MAX);
 
         let too_slow = Screencasting {
             frame_rate_hz: 1,
-            max_shm_buffers: 0,
         };
         assert_eq!(too_slow.frame_rate_hz(), Screencasting::FRAME_RATE_MIN);
-        assert_eq!(too_slow.max_shm_buffers(), Screencasting::SHM_BUFFERS_MIN);
     }
 
     #[test]
     fn values_inside_the_range_pass_through() {
         let s = Screencasting {
             frame_rate_hz: 30,
-            max_shm_buffers: 64,
         };
         assert_eq!(s.frame_rate_hz(), 30);
-        assert_eq!(s.max_shm_buffers(), 64);
     }
 }
