index a9784f77..dccd591a 100644
--- a/src/screencasting/pw_utils.rs
+++ b/src/screencasting/pw_utils.rs
@@ -90,7 +90,6 @@ pub struct PipeWire {
     /// Screencast limits, read from the niri config at startup. A config reload
     /// only applies to newly started casts.
     frame_rate_hz: u32,
-    max_shm_buffers: usize,
 }
 
 pub enum PwToNiri {
@@ -129,8 +128,6 @@ struct CastInner {
     state: CastState,
     refresh: u32,
     min_time_between_frames: Duration,
-    /// Bound on the shmem buffer pool for this stream, from the config.
-    max_shm_buffers: usize,
     dmabufs: HashMap<i64, Dmabuf>,
     shmbufs: HashMap<i64, Shmbuf>,
     /// Buffers dequeued from PipeWire in process of rendering.
@@ -455,7 +452,6 @@ impl PipeWire {
             event_loop,
             to_niri,
             frame_rate_hz: screencasting.frame_rate_hz(),
-            max_shm_buffers: screencasting.max_shm_buffers(),
         })
     }
 
@@ -476,7 +472,6 @@ impl PipeWire {
         let _span = debug_span!("start_cast", %session_id).entered();
 
         let frame_rate_hz = self.frame_rate_hz;
-        let max_shm_buffers = self.max_shm_buffers;
 
         let to_niri_ = self.to_niri.clone();
         let stop_cast = move || {
@@ -523,7 +518,6 @@ impl PipeWire {
             state: CastState::ResizePending { pending_size },
             refresh,
             min_time_between_frames: Duration::ZERO,
-            max_shm_buffers,
             dmabufs: HashMap::new(),
             shmbufs: HashMap::new(),
             rendering_buffers: Vec::new(),
@@ -1582,24 +1576,6 @@ impl CastInner {
 
                     let fd = (*(*spa_buffer).datas).fd;
                     assert!(self.shmbufs.insert(fd, shmbuf).is_none());
-
-                    // Bound the pool. Clients that stop draining the stream
-                    // (Electron-based screen sharing does) never return their
-                    // buffers, so on_remove_buffer never runs and the map -
-                    // and the shmem behind it - grows until the machine runs
-                    // out of RAM. Evicting the oldest entry drops our
-                    // reference, so once the client lets go the kernel frees
-                    // the pages.
-                    while self.shmbufs.len() > self.max_shm_buffers {
-                        let Some(oldest) = self.shmbufs.keys().next().copied() else {
-                            break;
-                        };
-                        warn!(
-                            "shm buffer pool over {}, evicting fd={oldest}",
-                            self.max_shm_buffers
-                        );
-                        self.shmbufs.remove(&oldest);
-                    }
                 }
 
                 Ok(self.shmbufs.len() == 1)
